# Общая Ollama может работать на этом или другом компьютере в домашней сети.
OLLAMA_HOST=localhost:11434

# Необязательно: стабильная подпись локальной session между перезапусками.
# Используйте длинное случайное значение и не копируйте его в git.
CV_AGENT_SESSION_KEY=replace-with-a-long-random-local-value

# Только если UI обслуживается через HTTPS reverse proxy.
CV_AGENT_SESSION_SECURE=0

# Gemini key задаётся отдельно в UI каждого семейного профиля и здесь не нужен.
# Groq key (console.groq.com/keys) также задаётся в UI профиля и здесь не нужен.
